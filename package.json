{
  "name": "scaffolding",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun run generate:llms development && vite --port 3000",
    "build": "bun run generate:llms && vite build",
    "generate:llms": "bun scripts/generate-llms.ts",
    "start": "node .output/server/index.mjs",
    "check": "biome check .",
